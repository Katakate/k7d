[Unit]
Description=Lightweight Kubernetes (k3s server)
Documentation=https://k3s.io
# Do not wait for network-online.target: systemd-networkd-wait-online is
# masked in this image (k7d-net.service owns eth0), and that target
# would otherwise hang k3s at start.
After=k7d-net.service
Wants=k7d-net.service

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
KillMode=process
Delegate=yes
# Named deny-vsock profile. Do not put this in service.d —
# that confines apparmor.service before profiles load (CHALLENGES #161).
# Pods inherit this profile; CRI AppArmor is off so runc does not
# change_onexec under no_new_privs (CHALLENGES #166).
AppArmorProfile=k7-deny-vsock
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe overlay
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStart=/usr/local/bin/k3s server
StandardOutput=journal+console
StandardError=journal+console
