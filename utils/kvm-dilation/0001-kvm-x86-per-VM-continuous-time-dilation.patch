+/* Largest dilation factor accepted; the TSC multiplier check bounds it too. */
+#define KVM_MAX_DILATION 64
+
+static void kvm_dilation_unlock_vcpus(struct kvm *kvm, int last)
+{
+	struct kvm_vcpu *vcpu;
+
+	for (; last >= 0; last--) {
+		vcpu = kvm_get_vcpu(kvm, last);
+		mutex_unlock(&vcpu->mutex);
+	}
+}
+
+/*
+ * Take every vCPU's mutex, or none of them.  KVM holds that mutex for the
+ * whole of KVM_RUN, so this succeeds exactly when no vCPU is executing --
+ * which is what k7d's cluster-wide pause window arranges.
+ * Same contract, and the same reason, as arm64's lock_all_vcpus().
+ */
+static bool kvm_dilation_lock_all_vcpus(struct kvm *kvm)
+{
+	struct kvm_vcpu *vcpu;
+	unsigned long i;
+
+	lockdep_assert_held(&kvm->lock);
+
+	kvm_for_each_vcpu(i, vcpu, kvm) {
+		if (!mutex_trylock(&vcpu->mutex)) {
+			kvm_dilation_unlock_vcpus(kvm, (int)i - 1);
+			return false;
+		}
+	}
+
+	return true;
+}
+
+/*
+ * Whether every vCPU can carry @factor on the hardware TSC multiplier.
+ * Asked before anything is written: a factor only part of a cluster can
+ * take would leave its members at different rates, and rates -- unlike
+ * offsets -- diverge without bound.
+ */
+static bool kvm_dilation_ratio_fits(struct kvm *kvm, u32 factor)
+{
+	struct kvm_vcpu *vcpu;
+	unsigned long i;
+	u64 ratio;
+
+	kvm_for_each_vcpu(i, vcpu, kvm) {
+		if (!vcpu->arch.virtual_tsc_khz)
+			return false;
+		ratio = mul_u64_u32_div((1ULL << kvm_caps.tsc_scaling_ratio_frac_bits) *
+						factor,
+					vcpu->arch.virtual_tsc_khz, tsc_khz);
+		if (ratio == 0 || ratio >= kvm_caps.max_tsc_scaling_ratio)
+			return false;
+	}
+
+	return true;
+}
+
+/*
+ * Reprogram one paused vCPU for the factor already stored in kvm->arch.
+ *
+ * The factor rides on the hardware TSC multiplier, so changing it changes
+ * what the guest's own counter reads by (ratio_new - ratio_old) * host_tsc.
+ * A guest whose TSC steps -- let alone steps backwards -- does not survive
+ * it, so the offset is rewritten to hold the counter at the value it had at
+ * @host_tsc.  That snapshot is shared by every vCPU of the VM so they all
+ * pivot on the same instant.  The LAPIC timer is re-armed at the new ratio
+ * before the vCPU is put, while it is still loaded.
+ */
+static int kvm_dilation_reload_vcpu(struct kvm_vcpu *vcpu, u64 host_tsc,
+				    u32 old)
+{
+	u64 guest_tsc;
+	int r;
+
+	vcpu_load(vcpu);
+	guest_tsc = kvm_read_l1_tsc(vcpu, host_tsc);
+	r = kvm_set_tsc_khz(vcpu, vcpu->arch.virtual_tsc_khz);
+	if (!r) {
+		kvm_vcpu_write_tsc_offset(vcpu,
+			guest_tsc - kvm_scale_tsc(host_tsc,
+						  vcpu->arch.l1_tsc_scaling_ratio));
+		kvm_lapic_dilation_changed(vcpu, old, vcpu->kvm->arch.dilation);
+	}
+	vcpu_put(vcpu);
+
+	return r ? -EIO : 0;
+}
+
+/*
+ * Set this VM's dilation factor, before any vCPU exists or
+ * on a live VM whose every vCPU is paused.
+ *
+ * A runnable vCPU is -EBUSY.  That is not conservatism: the factor is
+ * programmed per vCPU, and a VM whose vCPUs are at different rates has no
+ * single clock at all.
+ *
+ * Lowering the factor is not a rewind.  The affine pin keeps every
+ * nanosecond the guest has already been given (CHALLENGES #191 -- its
+ * CLOCK_REALTIME stays in the host's future); it only stops accumulating
+ * them so fast.
+ *
+ * The i8254's count_load_time is deliberately left alone: the guest
+ * calibrates against the PIT early in boot and then leaves it, and
+ * re-basing it would need pit_state.lock inside the all-vCPU lock.
+ */
+static int kvm_vm_set_dilation(struct kvm *kvm, u32 factor)
+{
+	struct kvm_vcpu *vcpu;
+	bool locked = false;
+	unsigned long i;
+	u64 host_tsc;
+	s64 now;
+	u32 old;
+	int r = 0;
+
+	if (factor < 1 || factor > KVM_MAX_DILATION)
+		return -EINVAL;
+	if (factor > 1 && !kvm_caps.has_tsc_control)
+		return -EOPNOTSUPP;
+
+	mutex_lock(&kvm->lock);
+	old = kvm->arch.dilation;
+
+	if (kvm->created_vcpus) {
+		/*
+		 * A vCPU that is created but not yet online is neither
+		 * lockable nor programmed, so there is no instant at which
+		 * the whole VM pivots.  Refuse rather than race it.
+		 */
+		if (kvm->created_vcpus != atomic_read(&kvm->online_vcpus) ||
+		    !kvm_dilation_lock_all_vcpus(kvm)) {
+			r = -EBUSY;
+			goto out;
+		}
+		locked = true;
+		if (!kvm_dilation_ratio_fits(kvm, factor)) {
+			r = -EINVAL;
+			goto out;
+		}
+	}
+
+	now = get_kvmclock_base_ns();
+	host_tsc = rdtsc();
+
+	/*
+	 * Re-pin the map and republish the masterclock together: the pvclock
+	 * scale and the hardware multiplier are two halves of one equation and
+	 * must never be observable apart.  No vCPU can enter the guest here --
+	 * they are all paused, and this is the window KVM itself uses for a
+	 * clock change.
+	 */
+	kvm_hv_request_tsc_page_update(kvm);
+	kvm_start_pvclock_update(kvm);
+	kvm->arch.dilation_base_out_ns = kvm_dilated_base_ns(kvm, now);
+	kvm->arch.dilation_base_ns = now;
+	kvm->arch.dilation = factor;
+	pvclock_update_vm_gtod_copy(kvm);
+	kvm_end_pvclock_update(kvm);
+
+	if (locked) {
+		kvm_for_each_vcpu(i, vcpu, kvm) {
+			r = kvm_dilation_reload_vcpu(vcpu, host_tsc, old);
+			if (r) {
+				/*
+				 * kvm_dilation_ratio_fits() says this cannot
+				 * happen.  If it does, the VM is at mixed
+				 * rates and only saying so is honest.
+				 */
+				pr_err("kvm: dilation x%u: vCPU %lu kept its old TSC rate\n",
+				       factor, i);
+				break;
+			}
+		}
+	}
+
+out:
+	if (locked)
+		kvm_dilation_unlock_vcpus(kvm, atomic_read(&kvm->online_vcpus) - 1);
+	mutex_unlock(&kvm->lock);
+
+	return r;
+}
