+/*
+ * k7d continuous time dilation.  A dilated guest sees @dilation ns of guest
+ * time pass per wall ns: its TSC really runs N x faster (hardware TSC
+ * multiplier) while its pvclock is told the undilated rate.  Emulated timers
+ * are armed on host hrtimers, so every guest-time interval they are handed
+ * has to be divided by N, and every host-time interval reported back to the
+ * guest multiplied by N.
+ */
+static inline u32 kvm_dilation(struct kvm *kvm)
+{
+	return kvm->arch.dilation;
+}
+
+/* Guest-time nanoseconds -> wall nanoseconds. */
+static inline u64 kvm_dilated_host_ns(struct kvm *kvm, u64 guest_ns)
+{
+	u32 n = kvm_dilation(kvm);
+
+	return n > 1 ? div_u64(guest_ns, n) : guest_ns;
+}
+
+/* Wall nanoseconds -> guest-time nanoseconds. */
+static inline u64 kvm_dilated_guest_ns(struct kvm *kvm, u64 host_ns)
+{
+	u32 n = kvm_dilation(kvm);
+
+	return n > 1 ? host_ns * n : host_ns;
+}
