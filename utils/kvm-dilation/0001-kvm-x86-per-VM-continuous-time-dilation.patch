+static int kvm_vm_ioctl_dilation_attr(struct kvm *kvm, unsigned int ioctl,
+				      void __user *argp)
+{
+	struct kvm_device_attr attr;
+	u32 __user *uaddr;
+	u32 factor;
+
+	if (copy_from_user(&attr, argp, sizeof(attr)))
+		return -EFAULT;
+
+	if (attr.group != KVM_VM_DILATION || attr.flags)
+		return -ENXIO;
+	if (attr.attr != KVM_VM_DILATION_FACTOR &&
+	    attr.attr != KVM_VM_DILATION_ABI)
+		return -ENXIO;
+
+	uaddr = u64_to_user_ptr(attr.addr);
+
+	switch (ioctl) {
+	case KVM_HAS_DEVICE_ATTR:
+		/* No hardware TSC multiplier, no dilation.  Say so. */
+		return kvm_caps.has_tsc_control ? 0 : -EOPNOTSUPP;
+	case KVM_GET_DEVICE_ATTR:
+		factor = attr.attr == KVM_VM_DILATION_ABI ? KVM_DILATION_ABI
+							  : kvm->arch.dilation;
+		return put_user(factor, uaddr) ? -EFAULT : 0;
+	case KVM_SET_DEVICE_ATTR:
+		/* The ABI generation is the patch's, not the caller's. */
+		if (attr.attr == KVM_VM_DILATION_ABI)
+			return -EPERM;
+		if (get_user(factor, uaddr))
+			return -EFAULT;
+		return kvm_vm_set_dilation(kvm, factor);
+	}
+
+	return -ENXIO;
+}
